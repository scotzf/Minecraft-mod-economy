{
	"schemaVersion": 1,
	"id": "pisomarket",
	"version": "${version}",
	"name": "Piso Market",
	"description": "A player-driven market economy: currency, asynchronous item listings, a system shop, and rented territory claims.",
	"authors": [
		"Denver"
	],
	"license": "CC0-1.0",
	"icon": "assets/pisomarket/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.pisomarket.PisoMarket"
		],
		"client": [
			"com.pisomarket.client.PisoMarketClient"
		]
	},
	"mixins": [
		"pisomarket.mixins.json",
		{
			"config": "pisomarket.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
